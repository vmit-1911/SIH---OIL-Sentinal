# ==============================================================================
# OIL SIF Sentinel — Environment Configuration Template (.env.example)
# Copy this file to .env and configure for your deployment environment.
# ==============================================================================

# Application Environment & Information
APP_NAME="OIL SIF Sentinel"
APP_ENV="development"                  # development | staging | production
DEBUG=false                            # Set to false in staging/production
API_V1_PREFIX="/api/v1"
API_VERSION="1.0"
SECRET_KEY="change_me_to_a_secure_random_string_in_production"

# Server Network Configuration
HOST="0.0.0.0"
PORT=8000

# Logging & Observability
LOG_LEVEL="INFO"                       # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT="JSON"                      # JSON (production/structured) | CONSOLE (local dev)

# PostgreSQL + pgvector Database Configuration
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/oil_sif_sentinel"
# Synchronous DB URL used by Alembic migrations
DATABASE_URL_SYNC="postgresql://postgres:postgres@localhost:5432/oil_sif_sentinel"

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_ECHO=false

# Taxonomy Settings
DEFAULT_TAXONOMY_ID="IOGP_REPORT_459"
TAXONOMY_DEFINITIONS_PATH="app/domain/taxonomy/iogp_report_459.json"

# Batch Pipeline Ingestion Settings
BATCH_MAX_FILE_SIZE_BYTES=10485760     # 10 MB in bytes
BATCH_CHUNK_SIZE=100                   # Chunk size for database persistence transactions

# Cross-Origin Resource Sharing (CORS)
# Comma-separated list of allowed origins (explicit in production)
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"
# CORS_ALLOWED_ORIGINS="https://hse-sentinel.oilindia.in"
